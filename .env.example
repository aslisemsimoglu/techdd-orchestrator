# LLM API Keys (required - choose one or both)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Semantic Scholar (optional - free tier works without key)
SEMANTIC_SCHOLAR_API_KEY=your_key_here

# UiPath Automation Cloud
UIPATH_CLIENT_ID=your_client_id_here
UIPATH_CLIENT_SECRET=your_client_secret_here
UIPATH_TENANT=your_tenant_name_here

# App Settings
LOG_LEVEL=INFO
MAX_PATENTS=50
MAX_PAPERS=50